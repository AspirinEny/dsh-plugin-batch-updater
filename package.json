{
  "name": "dsh-batch-updater",
  "version": "0.1.13",
  "description": "Adds an Updates tab to the DeepSeek Harness Plugins page: checks the plugins you installed yourself on a schedule, then updates the ones you tick.",
  "license": "MIT",
  "type": "module",
  "author": "AspirinEny",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AspirinEny/dsh-plugin-batch-updater.git"
  },
  "homepage": "https://github.com/AspirinEny/dsh-plugin-batch-updater#readme",
  "bugs": {
    "url": "https://github.com/AspirinEny/dsh-plugin-batch-updater/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin-manager",
    "update"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "locale": "node scripts/embed-locale.mjs",
    "test": "node test/host.test.mjs && node test/client.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
